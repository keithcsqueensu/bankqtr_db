# Normalise to LF in the repository so the tree is identical on Windows,
# Linux and CI.  Without this the panel's own line endings depend on which
# machine ran the build.
* text=auto eol=lf

# Generated artefacts: never diffed by eye, and a CSV diff of a 1.2 MB panel
# is noise rather than review.
*.parquet binary
data/out/*.csv linguist-generated=true
uv.lock linguist-generated=true
